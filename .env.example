##### PUBLIC #####
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_HARBOR_URL=http://localhost:5000

##### PRIVATE #####
API_URL=http://localhost:8299
REDIS_URL=redis://:your_secure_password_here@localhost:6379

KEYCLOAK_REALM_URL=http://localhost:8080/realms/your_realm
KEYCLOAK_CLIENT_ID=your_client_id
KEYCLOAK_CLIENT_SECRET=your_client_secret

# When Keycloak / the API are served with a private-CA (self-signed) certificate,
# server-side fetch fails with UNABLE_TO_VERIFY_LEAF_SIGNATURE. Point Node at the
# CA bundle to trust it — this is a real process env var, read at Node startup,
# not loaded from this file. The Helm chart sets it to the mounted otterscale-ca
# secret; for local dev, export the cluster CA and pass it on the command line:
#
#   kubectl get secret -n otterscale-system otterscale-ca \
#     -o jsonpath='{.data.ca\.crt}' | base64 -d > ./otterscale-ca.crt
#   NODE_EXTRA_CA_CERTS=$PWD/otterscale-ca.crt pnpm dev --host
#
# NODE_EXTRA_CA_CERTS=/etc/otterscale/ca/ca.crt
